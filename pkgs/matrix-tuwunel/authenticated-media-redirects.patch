+	pub async fn client_redirect_url(
+		&self,
+		mxc: &Mxc<'_>,
+		dim: &Dim,
+		animate: Animate,
+		filename: Option<&str>,
+	) -> Result<Option<Url>> {
+		let config = &self.services.config;
+		if !config.media.allow_redirect
+			|| config.media.deny_framing
+			|| config.media.deny_inline_styles
