diff --git a/include/CursorTracker/CursorTrackerKwin.hpp b/include/CursorTracker/CursorTrackerKwin.hpp
new file mode 100644
index 0000000..1fc0016
--- /dev/null
+++ b/include/CursorTracker/CursorTrackerKwin.hpp
@@ -0,0 +1,26 @@
+#pragma once
+
+#include "CursorTracker.hpp"
+
+struct wl_display;
+
+namespace gsr {
+    // Asks KWin which output is active (by default the active output follows the mouse)
+    // instead of walking the planes of every gpu over DRM like CursorTrackerDrm does.
+    // Every DRM ioctl runtime-resumes the gpu, so polling all gpus keeps a laptop dGPU
+    // that has no display connected from ever suspending.
+    class CursorTrackerKwin : public CursorTracker {
+    public:
+        static bool is_supported();
+
+        CursorTrackerKwin(struct wl_display *wayland_dpy);
+        CursorTrackerKwin(const CursorTrackerKwin&) = delete;
+        CursorTrackerKwin& operator=(const CursorTrackerKwin&) = delete;
+        ~CursorTrackerKwin() = default;
+
+        void update() override {}
+        std::optional<CursorInfo> get_latest_cursor_info() override;
+    private:
+        struct wl_display *wayland_dpy = nullptr;
+    };
+}
