From: Chowdhury-DSP/chowdsp_utils
Subject: [PATCH] Rectangle: fix dimension member names

Upstream: https://github.com/Chowdhury-DSP/chowdsp_utils/commit/cba7f1a8e68c56b61372953e60b5f44794ddd218

--- a/modules/chowdsp_utils/modules/common/chowdsp_core/DataStructures/chowdsp_GraphicsHelpers.h
+++ b/modules/chowdsp_utils/modules/common/chowdsp_core/DataStructures/chowdsp_GraphicsHelpers.h
@@ -359,4 +359,4 @@
         const Rectangle r { position.x, position.y, width, juce::jmin (amountToRemove, height) };
-        position.y += r.h;
-        height -= r.h;
+        position.y += r.height;
+        height -= r.height;
         return r;
@@ -367,4 +367,4 @@
         const Rectangle r { position.x, position.y, juce::jmin (amountToRemove, width), height };
-        position.x += r.w;
-        width -= r.w;
+        position.x += r.width;
+        width -= r.width;
         return r;
