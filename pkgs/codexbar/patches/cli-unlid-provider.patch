index 000000000..e172188d9
--- /dev/null
+++ b/Sources/CodexBarCore/Resources/Plugins/unlid.js
@@ -0,0 +1,98 @@
+function _optionalChain(ops) {
+  let lastAccessLHS = undefined;
+  let value = ops[0];
+  let i = 1;
+  while (i < ops.length) {
+    const op = ops[i];
+    const fn = ops[i + 1];
+    i += 2;
+    if ((op === "optionalAccess" || op === "optionalCall") && value == null) {
+      return undefined;
+    }
+    if (op === "access" || op === "optionalAccess") {
+      lastAccessLHS = value;
+      value = fn(value);
+    } else if (op === "call" || op === "optionalCall") {
+      value = fn((...args) => value.call(lastAccessLHS, ...args));
+      lastAccessLHS = undefined;
+    }
+  }
+  return value;
+}
+defineProvider({
+  id: "unlid",
+  name: "Unlid",
+  endpoints: ["https://api.unlid.ai"],
+  auth: { type: "bearer", secret: "UNLID_API_KEY" },
+  settings: [{ key: "UNLID_API_KEY", title: "API key", type: "secure" }],
+  capabilities: ["http-status"],
+  async fetchUsage(ctx) {
+    // The account summary is required. Lifetime credits are optional and may be unavailable.
+    const response = await ctx.http.getWithOptional("https://api.unlid.ai/v1/me", "https://api.unlid.ai/v1/credits");
+    if (response.status === 401) throw ctx.fail.authenticationExpired("Check your Unlid API key in Settings.");
+    if (response.status === 403)
+      throw ctx.fail.permissionDenied("Unlid denied access. Check your account and API key permissions.");
+    if (response.status === 429) throw ctx.fail.rateLimited("Unlid is rate limiting requests. Try again later.");
+    if (response.status >= 500) throw ctx.fail.providerUnavailable("Unlid is unavailable. Try refreshing later.");
+    if (response.status !== 200) throw ctx.fail.apiFailure("Unlid request failed. Try refreshing later.");
+    const fail = () => {
+      throw ctx.fail.parseFailure("Unlid returned an unrecognized account summary. Update CodexBar and try again.");
+    };
+    const record = (value) => (value && typeof value === "object" && !Array.isArray(value) ? value : undefined);
+    const decode = (text) => {
+      try {
+        return record(JSON.parse(text));
+      } catch (error) {
+        void error;
+        return undefined;
+      }
+    };
+    const money = (value) => typeof value === "number" && Number.isFinite(value);
+    const nonnegative = (value) => money(value) && value >= 0;
+    const me = decode(response.bodyText);
+    const balance = _optionalChain([me, "optionalAccess", (_) => _.balance_usd]);
+    const held = _optionalChain([me, "optionalAccess", (_2) => _2.held_usd]);
+    const month = _optionalChain([me, "optionalAccess", (_3) => _3.month_spend_usd]);
+    if (!money(balance) || !nonnegative(held) || !nonnegative(month)) return fail();
+    // Never substitute credits-minus-usage for the authoritative balance from /me.
+    const rows = [
+      { label: "Balance", value: ctx.format.usd(balance) },
+      { label: "Open holds", value: ctx.format.usd(held) },
+      { label: "Available balance", value: ctx.format.usd(balance - held) },
+      { label: "This month spent", value: ctx.format.usd(month) },
+    ];
+    const name = _optionalChain([
+      record,
+      "call",
+      (_4) => _4(_optionalChain([me, "optionalAccess", (_5) => _5.key])),
+      "optionalAccess",
+      (_6) => _6.name,
+    ]);
+    if (typeof name === "string" && name.trim()) rows.push({ label: "API key name", value: name.trim() });
+    const credits =
+      _optionalChain([response, "access", (_7) => _7.optional, "optionalAccess", (_8) => _8.status]) === 200
+        ? record(
+            _optionalChain([
+              decode,
+              "call",
+              (_9) => _9(response.optional.bodyText),
+              "optionalAccess",
+              (_10) => _10.data,
+            ]),
+          )
+        : undefined;
+    const total = _optionalChain([credits, "optionalAccess", (_11) => _11.total_credits]);
+    const used = _optionalChain([credits, "optionalAccess", (_12) => _12.total_usage]);
+    let primary;
+    if (nonnegative(total) && nonnegative(used)) {
+      rows.push({ label: "Lifetime credits", value: ctx.format.usd(total) });
+      rows.push({ label: "Lifetime spent", value: ctx.format.usd(used) });
+      if (total > 0)
+        primary = {
+          usedPercent: ctx.pct(used, total),
+          resetDescription: `${ctx.format.usd(used)} / ${ctx.format.usd(total)} lifetime`,
+        };
+    }
+    return { primary, details: [{ title: "Account balance (USD)", rows }], dataConfidence: "exact" };
+  },
+});
diff --git a/Sources/CodexBarCore/Resources/Plugins/unlid.ts b/Sources/CodexBarCore/Resources/Plugins/unlid.ts
new file mode 100644
index 000000000..978e91cb7
--- /dev/null
+++ b/Sources/CodexBarCore/Resources/Plugins/unlid.ts
@@ -0,0 +1,61 @@
+defineProvider({
+  id: "unlid",
+  name: "Unlid",
+  endpoints: ["https://api.unlid.ai"],
+  auth: { type: "bearer", secret: "UNLID_API_KEY" },
+  settings: [{ key: "UNLID_API_KEY", title: "API key", type: "secure" }],
+  capabilities: ["http-status"],
+  async fetchUsage(ctx) {
+    // The account summary is required. Lifetime credits are optional and may be unavailable.
+    const response = await ctx.http.getWithOptional("https://api.unlid.ai/v1/me", "https://api.unlid.ai/v1/credits");
+    if (response.status === 401) throw ctx.fail.authenticationExpired("Check your Unlid API key in Settings.");
+    if (response.status === 403)
+      throw ctx.fail.permissionDenied("Unlid denied access. Check your account and API key permissions.");
+    if (response.status === 429) throw ctx.fail.rateLimited("Unlid is rate limiting requests. Try again later.");
+    if (response.status >= 500) throw ctx.fail.providerUnavailable("Unlid is unavailable. Try refreshing later.");
+    if (response.status !== 200) throw ctx.fail.apiFailure("Unlid request failed. Try refreshing later.");
+    const fail = (): never => {
+      throw ctx.fail.parseFailure("Unlid returned an unrecognized account summary. Update CodexBar and try again.");
+    };
+    const record = (value: unknown): Record<string, unknown> | undefined =>
+      value && typeof value === "object" && !Array.isArray(value) ? (value as Record<string, unknown>) : undefined;
+    const decode = (text: string): Record<string, unknown> | undefined => {
+      try {
+        return record(JSON.parse(text));
+      } catch (error) {
+        void error;
+        return undefined;
+      }
+    };
+    const money = (value: unknown): value is number => typeof value === "number" && Number.isFinite(value);
+    const nonnegative = (value: unknown): value is number => money(value) && value >= 0;
+    const me = decode(response.bodyText);
+    const balance = me?.balance_usd;
+    const held = me?.held_usd;
+    const month = me?.month_spend_usd;
+    if (!money(balance) || !nonnegative(held) || !nonnegative(month)) return fail();
+    // Never substitute credits-minus-usage for the authoritative balance from /me.
+    const rows: CodexBarDetailRow[] = [
+      { label: "Balance", value: ctx.format.usd(balance) },
+      { label: "Open holds", value: ctx.format.usd(held) },
+      { label: "Available balance", value: ctx.format.usd(balance - held) },
+      { label: "This month spent", value: ctx.format.usd(month) },
+    ];
+    const name = record(me?.key)?.name;
+    if (typeof name === "string" && name.trim()) rows.push({ label: "API key name", value: name.trim() });
+    const credits = response.optional?.status === 200 ? record(decode(response.optional.bodyText)?.data) : undefined;
+    const total = credits?.total_credits;
+    const used = credits?.total_usage;
+    let primary: CodexBarRateWindow | undefined;
+    if (nonnegative(total) && nonnegative(used)) {
+      rows.push({ label: "Lifetime credits", value: ctx.format.usd(total) });
+      rows.push({ label: "Lifetime spent", value: ctx.format.usd(used) });
+      if (total > 0)
+        primary = {
+          usedPercent: ctx.pct(used, total),
+          resetDescription: `${ctx.format.usd(used)} / ${ctx.format.usd(total)} lifetime`,
+        };
+    }
+    return { primary, details: [{ title: "Account balance (USD)", rows }], dataConfidence: "exact" };
+  },
+});
