+++ b/TestsLinux/UnlidProviderTests.swift
@@ -0,0 +1,62 @@
+import Foundation
+import Testing
+@testable import CodexBarCLI
+@testable import CodexBarCore
+
+struct UnlidProviderTests {
+    @Test
+    func `provider is registered with API sources setup and isolated credentials`() throws {
+        let descriptor = UnlidProviderDescriptor.descriptor
+        #expect(ProviderSelection(argument: "UNLID")?.asList == [.unlid])
+        #expect(ProviderManifest.allDescriptors.contains { $0.id == .unlid })
+        #expect(descriptor.fetchPlan.sourceModes == [.auto, .api])
+        #expect(descriptor.history == .unavailable)
+        #expect(!descriptor.metadata.burnDownWidgetSelectable)
+        #expect(descriptor.metadata.usesDetailBackedWindow)
+        let credentials = try #require(descriptor.credentials)
+        let environment = credentials.applyConfig(
+            base: ["UNLID_API_KEY": "ul-environment", "OPENAI_API_KEY": "other-provider-fixture"],
+            config: ProviderConfig(id: .unlid, apiKey: "ul-config"))
+        #expect(credentials.resolveToken(environment: environment)?.token == "ul-config")
+        #expect(credentials.resolveToken(environment: ["OPENAI_API_KEY": "other-provider-fixture"]) == nil)
+        #expect(descriptor.branding.iconResourceName == "ProviderIcon-unlid")
+    }
+
+    @Test
+    func `selected Unlid account wins over standalone and ambient keys`() throws {
+        let accounts = ProviderTokenAccountData(version: 1, accounts: [
+            ProviderTokenAccount(id: UUID(), label: "Fixture A", token: "ul-account-a", addedAt: 0, lastUsed: nil),
+            ProviderTokenAccount(id: UUID(), label: "Fixture B", token: "ul-account-b", addedAt: 0, lastUsed: nil),
+        ], activeIndex: 1)
+        let config = CodexBarConfig(providers: [ProviderConfig(
+            id: .unlid, apiKey: "ul-config", tokenAccounts: accounts)])
+        let context = try TokenAccountCLIContext(
+            selection: TokenAccountCLISelection(label: nil, index: nil, allAccounts: false),
+            config: config,
+            verbose: false,
+            baseEnvironment: [:],
+            configStore: CodexBarConfigStore(fileURL: FileManager.default.temporaryDirectory
+                .appendingPathComponent("unlid-fixture-\(UUID())/config.json")))
+        let selected = try context.resolvedAccounts(for: .unlid).first
+        #expect(selected?.id == accounts.accounts[1].id)
+        let environment = context.environment(
+            base: ["UNLID_API_KEY": "ul-environment"], provider: .unlid, account: selected)
+        #expect(UnlidProviderDescriptor.spec.apiKey(environment: environment) == "ul-account-b")
+    }
+
+    @Test
+    func `CLI presents lifetime amounts without a fabricated reset`() throws {
+        let snapshot = try UsageSnapshot(
+            primary: RateWindow(
+                usedPercent: 60, windowMinutes: nil, resetsAt: nil,
+                resetDescription: "$15.00 / $25.00 lifetime"),
+            secondary: nil,
+            details: [ProviderDetailSection(title: "Balance", rows: [.init(label: "Balance", value: "$10.00")])],
+            updatedAt: Date())
+        let text = CLIRenderer.renderText(
+            provider: .unlid, snapshot: snapshot, credits: nil,
+            context: RenderContext(header: "Unlid", status: nil, useColor: false, resetStyle: .countdown))
+        #expect(text.contains("$15.00 / $25.00 lifetime"))
+        #expect(!text.contains("Resets $"))
+    }
+}
