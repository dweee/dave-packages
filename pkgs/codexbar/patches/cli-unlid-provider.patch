@@ -0,0 +1,142 @@
+import Foundation
+import Testing
+@testable import CodexBarCore
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+
+struct UnlidPluginTests {
+    private static let summary = #"{"key":{"name":"fixture key","prefix":"private-prefix","id":"private-id"},"balance_usd":24.9991,"held_usd":0.0041,"month_spend_usd":3.12}"#
+    private static let credits = #"{"data":{"total_credits":25,"total_usage":14.82}}"#
+
+    @Test(arguments: BundledPluginTestSupport.engines)
+    func `documented summary keeps account amounts separate from lifetime credits`(
+        engine: ProviderPluginEngineKind) async throws
+    {
+        let usage = try await Self.fetch(engine)
+        #expect(usage.detailRow(label: "Balance")?.value == "$25.00")
+        #expect(usage.detailRow(label: "Available balance")?.value == "$24.99")
+        #expect(usage.detailRow(label: "Open holds")?.value == "$0.00")
+        #expect(usage.detailRow(label: "This month spent")?.value == "$3.12")
+        #expect(usage.detailRow(label: "API key name")?.value == "fixture key")
+        #expect(abs((usage.primary?.usedPercent ?? -1) - 59.28) < 0.000001)
+        #expect(usage.primary?.resetDescription == "$14.82 / $25.00 lifetime")
+        #expect(usage.primary?.resetsAt == nil)
+        #expect(usage.primary?.windowMinutes == nil)
+        #expect(usage.secondary == nil)
+        #expect(usage.identity == nil)
+        #expect(usage.providerCost == nil)
+        let json = try String(decoding: JSONEncoder().encode(usage), as: UTF8.self)
+        #expect(!json.contains("private-prefix"))
+        #expect(!json.contains("private-id"))
+    }
+
+    @Test(arguments: BundledPluginTestSupport.engines)
+    func `optional credits errors and malformed amounts retain the required summary`(
+        engine: ProviderPluginEngineKind) async throws
+    {
+        let unavailable = try await Self.fetch(engine, creditsUnavailable: true)
+        #expect(unavailable.primary == nil)
+        #expect(unavailable.detailRow(label: "Balance")?.value == "$25.00")
+        for status in [401, 403, 429, 500] {
+            let usage = try await Self.fetch(engine, creditsStatus: status)
+            #expect(usage.primary == nil)
+            #expect(usage.detailRow(label: "Balance")?.value == "$25.00")
+        }
+        for body in [
+            "bad-json",
+            "[]",
+            "{}",
+            #"{"data":{"total_credits":25,"total_usage":-1}}"#,
+            #"{"data":{"total_credits":true,"total_usage":0}}"#,
+            #"{"data":{"total_credits":1e309,"total_usage":0}}"#,
+        ] {
+            let usage = try await Self.fetch(engine, credits: body)
+            #expect(usage.primary == nil)
+            #expect(usage.detailRow(label: "Lifetime spent") == nil)
+            #expect(usage.detailRow(label: "Balance") != nil)
+        }
+    }
+
+    @Test(arguments: BundledPluginTestSupport.engines)
+    func `zero credits overspend and reservations never invent allowances`(
+        engine: ProviderPluginEngineKind) async throws
+    {
