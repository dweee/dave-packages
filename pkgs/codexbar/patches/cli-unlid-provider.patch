+                #expect(["/v1/me", "/v1/credits"].contains(url.path))
+                let required = url.path == "/v1/me"
+                if !required, creditsUnavailable { throw URLError(.timedOut) }
+                let response = try #require(HTTPURLResponse(
+                    url: url, statusCode: required ? status : creditsStatus, httpVersion: nil, headerFields: nil))
+                return (Data((required ? summary : credits).utf8), response)
