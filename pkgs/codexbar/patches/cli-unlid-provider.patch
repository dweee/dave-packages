@@ -0,0 +1,23 @@
+import Testing
+@testable import CodexBar
+@testable import CodexBarCore
+
+@MainActor
+struct UnlidProviderTests {
+    @Test
+    func `API key field uses standard provider storage and availability`() throws {
+        let fixture = try ProviderSettingsDescriptorTests().makeSettingsFixture(suite: "UnlidProviderTests")
+        let implementation = try #require(ProviderCatalog.implementation(for: .unlid))
+        let fields = implementation.settingsFields(context: fixture.settingsContext(provider: .unlid))
+        let field = try #require(fields.first)
+        #expect(fields.count == 1)
+        #expect(field.kind == .secure)
+        #expect(field.title == "API key")
+        #expect(!implementation.isAvailable(context: .init(
+            provider: .unlid, settings: fixture.settings, environment: [:])))
+        field.binding.wrappedValue = "ul-fixture"
+        #expect(fixture.settings[providerConfig: .unlid, field: .apiKey] == "ul-fixture")
+        #expect(implementation.isAvailable(context: .init(
+            provider: .unlid, settings: fixture.settings, environment: [:])))
+    }
+}
