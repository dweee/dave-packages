+        (lexer->lookahead >= 'A' && lexer->lookahead <= 'Z'))) {
+    return false;
+  }
+
+  while (is_language_char(lexer->lookahead)) {
+    advance(lexer);
+  }
+  lexer->mark_end(lexer);
+  return true;
+}
